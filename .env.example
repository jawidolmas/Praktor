# Where the supervisor keeps its own protected state (SQLite file, checkpoints).
# Workers are policy-denied from writing anywhere under this path. Fixed under
# the home directory by default (~/.exec-agent) regardless of which directory
# you run exec-agent from — one central database, not one per invoking cwd.
# Uncomment to scope state to a single project instead:
# EXEC_HOME=./.exec

# Where worker git worktrees live. Deliberately separate from EXEC_HOME — a
# worktree is the worker's own output, not supervisor state, and must not sit
# under the path POLICY-005 protects. Same fixed-by-default reasoning as above.
# EXEC_WORKTREES_DIR=./.exec-worktrees

# Where per-repo graphify knowledge graphs are cached. One graph per repo,
# shared across every task and attempt run against it — kept outside the repo
# itself (and outside EXEC_WORKTREES_DIR) the same way worktrees are kept
# outside your real repo. Requires graphify to be installed (see README
# Prerequisites); a missing install does not stop exec-agent, it just runs
# workers without this MCP server.
# EXEC_GRAPHS_DIR=./.exec-graphs

# Worker concurrency. 1 on a Claude Pro subscription; raise on Max or with an API key.
# This build only ever runs one worker regardless — raising this does nothing yet.
EXEC_MAX_WORKERS=1

# Extra places `exec-agent do` should look for a repo by name, beyond ~/Desktop.
# Comma- or semicolon-separated.
# EXEC_REPO_SEARCH_PATHS=~/code,~/dev

# Telegram bridge: when both are set, the daemon pushes every decision a
# worker raises straight to this chat (with tappable option buttons) instead
# of only waiting for someone to be watching a terminal or the dashboard —
# and answers tapped there unblock the worker the same way `exec-agent
# decide` does. Create a bot via @BotFather in Telegram to get a token; get
# your chat id by messaging the bot once and reading it back off
# https://api.telegram.org/bot<token>/getUpdates. Loaded automatically from
# this file by the daemon (not by your shell) — no need to `export` these.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Local hour (0-23) the daily digest fires at. Defaults to 8 (8am). Only
# matters if the Telegram bridge above is configured.
# TELEGRAM_DIGEST_HOUR=8
