{
  "name": "exec-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An executive agent that supervises Claude Code as a workforce: give it an objective, get back verified work and a report.",
  "license": "MIT",
  "author": "Jawid Olmas",
  "repository": {
    "type": "git",
    "url": "https://github.com/jawidolmas/Praktor.git"
  },
  "homepage": "https://github.com/jawidolmas/Praktor",
  "bugs": "https://github.com/jawidolmas/Praktor/issues",
  "bin": {
    "exec-agent": "./bin/exec-agent.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepare": "tsc --build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "exec": "tsx apps/cli/src/index.ts",
    "dashboard": "tsx apps/web/src/index.ts",
    "site": "tsx apps/site/src/index.ts",
    "daemon": "tsx apps/daemon/src/index.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
